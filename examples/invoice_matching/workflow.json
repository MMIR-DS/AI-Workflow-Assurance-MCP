{
  "id": "invoice-match",
  "name": "Invoice matching workflow",
  "version": "1.0.0",
  "description": "Example acceptance checks for an AI-assisted three-way invoice match. Synthetic data only.",
  "criteria": [
    {
      "id": "decision_matches_reviewed_label",
      "operator": "equals",
      "actual_path": "decision",
      "expected_path": "decision",
      "severity": "high"
    },
    {
      "id": "human_review_flag_matches",
      "operator": "equals",
      "actual_path": "requires_human_review",
      "expected_path": "requires_human_review",
      "severity": "critical"
    },
    {
      "id": "amount_variance_matches",
      "operator": "approx",
      "actual_path": "amount_variance",
      "expected_path": "amount_variance",
      "tolerance": 0.01,
      "severity": "high"
    },
    {
      "id": "rationale_present",
      "operator": "non_empty",
      "actual_path": "rationale",
      "severity": "low"
    }
  ],
  "thresholds": {
    "min_pass_rate": 0.95,
    "max_critical_failures": 0,
    "max_high_failures": 0,
    "max_review_rate": 0.8,
    "max_avg_cost_usd": 0.1,
    "max_avg_latency_ms": 2500,
    "max_case_cost_usd": 0.5,
    "max_case_latency_ms": 10000
  }
}
